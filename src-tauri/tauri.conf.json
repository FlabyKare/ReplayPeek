{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Reply Overlay",
  "version": "0.1.0",
  "identifier": "app.reply-overlay.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Reply Overlay",
        "width": 980,
        "height": 760,
        "minWidth": 760,
        "minHeight": 620,
        "center": true,
        "resizable": true,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "shortDescription": "Capture text and prepare quick replies",
    "windows": {
      "wix": null,
      "nsis": null
    }
  }
}
