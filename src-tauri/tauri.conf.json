{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ReplayPeek",
  "version": "0.4.2",
  "identifier": "app.reply-overlay.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ReplayPeek",
        "width": 980,
        "height": 760,
        "minWidth": 760,
        "minHeight": 620,
        "center": true,
        "resizable": true,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data: https:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost https://replaypeek-sync-api-production.up.railway.app"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "shortDescription": "Capture text and prepare quick replies",
    "windows": {
      "wix": null,
      "nsis": null
    }
  },
  "plugins": {
    "updater": {
      "endpoints": ["https://github.com/FlabyKare/ReplayPeek/releases/latest/download/latest.json"],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQzRUFCM0EwRjk0NzBDNwpSV1RIY0pRUE9xcytEWWFjcjc3QkJqQmZ1VW5ORndPSlJmWnl1MWpGa29VSmdiWmR2M2diOWNVbAo=",
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
